From fd7a3561539b20a2d6b1364f0a53cff8ac4c2985 Mon Sep 17 00:00:00 2001
From: Ahmed Mohamed <50212311+ig4e@users.noreply.github.com>
Date: Sat, 22 Aug 2026 14:39:36 +0300
Subject: [PATCH] Handle scaled E-Hentai metadata rows


diff --git a/.audit/j2k-reset.tsv b/.audit/j2k-reset.tsv
index 572108de449a34c3708ca33caee4f15ddea2aa1f..68e72a0fbedcb0385ce48cd347ef9013fcda0ef3 100644
--- a/.audit/j2k-reset.tsv
+++ b/.audit/j2k-reset.tsv
@@ -95,3 +95,4 @@ ts	phase	decision	why	evidence	result
 2026-08-22T14:25:00+03:00	j2k-eh-settings-navigation	replaced the standalone E-Hentai settings activity with a native J2K SettingsController	preserved login results, session verification, the remote settings matrix and retry, watched tags, favorites planning and sync, category mapping, updater policy, statistics, immediate run, and cancellation while deleting the duplicate toolbar and activity shell	EhSettingsController.kt; BrowseSourceController.kt; SettingsAdvancedController.kt; SourcePreviewController.kt	IMPLEMENTED_UNVERIFIED
 2026-08-22T15:10:00+03:00	sy-source-details-ui	replaced the custom horizontal preview strip and generic enhanced-source summaries with their SY presentation contracts	used adaptive full-width preview rows, fit-width 120 by 200 dp cells, J2K text actions and empty state, plus source-specific E-Hentai, ExHentai, 8Muses, HBrowse, NHentai, Pururin, and LANraragi description layouts reconstructed from pinned SY while retaining typed Hayai data and loaders	SourceMetadataUi.kt; SourcePreviewController.kt; MangaDetailsController.kt; hayai_sy_description_*.xml; manga_header_item.xml	IMPLEMENTED_UNVERIFIED
 2026-08-22T15:42:00+03:00	j2k-novel-reader-controls	replaced the remaining bespoke novel option controls and arrow-order editor with native J2K layouts and interaction patterns	preserved the full preference surface and immediate reader updates while using J2K filter and text buttons, subtitle labels, material dialogs, and draggable download-header cards; subtitle values prevent 100 percent from colliding with or wrapping through the title	NovelReaderSettingsSheet.kt; novel-reader-parity.md	COMPILED
+2026-08-22T16:40:00+03:00	sy-eh-metadata-responsiveness	fixed the emulator-discovered empty gallery badge and clipped metadata action at large display and font scales	kept the SY information hierarchy while using J2K's Material 3 text-button style, wrap-content height, two-line fallback, and an explicit localized unknown type for absent upstream category data	hayai_sy_description_eh.xml; SourceMetadataUi.kt	IMPLEMENTED_UNVERIFIED
diff --git a/app/src/main/java/dev/ahmedmohamed/hayai/source/metadata/SourceMetadataUi.kt b/app/src/main/java/dev/ahmedmohamed/hayai/source/metadata/SourceMetadataUi.kt
index cda4f4c86846d1af5496a091535472f5ed3ffcb1..052919c7e551bc54f35d53b59c3b777c4c54688e 100644
--- a/app/src/main/java/dev/ahmedmohamed/hayai/source/metadata/SourceMetadataUi.kt
+++ b/app/src/main/java/dev/ahmedmohamed/hayai/source/metadata/SourceMetadataUi.kt
@@ -349,7 +349,7 @@ object SourceMetadataUi {
             "cosplay" -> R.string.hayai_source_type_cosplay
             "asianporn", "asian porn" -> R.string.hayai_source_type_asian_porn
             "misc" -> R.string.hayai_source_type_misc
-            else -> return type
+            else -> return type.ifBlank { context.getString(R.string.unknown) }
         }
         return context.getString(label)
     }
diff --git a/app/src/main/res/layout/hayai_sy_description_eh.xml b/app/src/main/res/layout/hayai_sy_description_eh.xml
index 320d27c0391fe1429c9f86e345a6702366f792a6..080b81b6470f6a74f16b7058c0433aaee475eb74 100644
--- a/app/src/main/res/layout/hayai_sy_description_eh.xml
+++ b/app/src/main/res/layout/hayai_sy_description_eh.xml
@@ -41,12 +41,13 @@
             app:layout_constraintStart_toStartOf="parent"
             app:layout_constraintTop_toTopOf="parent" />
 
-        <Button
+        <com.google.android.material.button.MaterialButton
             android:id="@+id/hayai_sy_more_info"
-            style="?attr/borderlessButtonStyle"
+            style="@style/Widget.Material3Expressive.Button.TextButton"
             android:layout_width="wrap_content"
-            android:layout_height="36dp"
+            android:layout_height="wrap_content"
             android:layout_marginEnd="16dp"
+            android:maxLines="2"
             android:text="@string/hayai_source_metadata_more_info"
             app:layout_constraintEnd_toEndOf="parent"
             app:layout_constraintTop_toTopOf="parent" />
