diff --git a/app/src/test/java/dev/ahmedmohamed/hayai/source/metadata/SourceMetadataDocumentTest.kt b/app/src/test/java/dev/ahmedmohamed/hayai/source/metadata/SourceMetadataDocumentTest.kt
new file mode 100644
