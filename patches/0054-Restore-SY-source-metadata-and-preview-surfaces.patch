diff --git a/app/src/test/java/dev/ahmedmohamed/hayai/adult/eh/source/EhTagSelectionCodecTest.kt b/app/src/test/java/dev/ahmedmohamed/hayai/adult/eh/source/EhTagSelectionCodecTest.kt
