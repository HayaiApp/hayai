diff --git a/app/src/main/java/dev/ahmedmohamed/hayai/source/SourceCapabilityRegistry.kt b/app/src/main/java/dev/ahmedmohamed/hayai/source/SourceCapabilityRegistry.kt
new file mode 100644
index 0000000000000000000000000000000000000000..28ddb4bb94262d45a99db1790a6fb98b5cb4f051
