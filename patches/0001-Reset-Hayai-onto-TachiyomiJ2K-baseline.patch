diff --git a/tools/apply-patchset.ps1 b/tools/apply-patchset.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..78f8975a35995736a272fe25fb20f6c2efe4deb8
--- /dev/null
+++ b/tools/apply-patchset.ps1
@@ -0,0 +1,42 @@
+$ErrorActionPreference = "Stop"
+$repositoryRoot = (Resolve-Path (Join-Path $PSScriptRoot "..")).Path
+$patchRoot = (Resolve-Path (Join-Path $repositoryRoot "patches")).Path
+
+if ((Split-Path -Parent $patchRoot) -ne $repositoryRoot) {
+    throw "Patch directory escaped the repository root: $patchRoot"
+}
+
+Push-Location $repositoryRoot
+try {
+    if (git status --porcelain) {
+        throw "Apply the patch stack only from a clean worktree."
+    }
+
+    $expectedBase = (Get-Content -LiteralPath (Join-Path $patchRoot "UPSTREAM_BASE") -Raw).Trim()
+    $currentCommit = (git rev-parse HEAD).Trim()
+    if ($currentCommit -ne $expectedBase) {
+        throw "HEAD is $currentCommit; the patch stack requires $expectedBase."
+    }
+
+    $patchNames = Get-Content -LiteralPath (Join-Path $patchRoot "series") | Where-Object { $_ -and -not $_.StartsWith("#") }
+    if (!$patchNames) {
+        throw "The patch series is empty. Run tools/refresh-patchset.ps1 after committing the Hayai delta."
+    }
+
+    $patchPaths = @()
+    foreach ($patchName in $patchNames) {
+        $candidate = (Resolve-Path (Join-Path $patchRoot $patchName)).Path
+        if ((Split-Path -Parent $candidate) -ne $patchRoot -or [IO.Path]::GetExtension($candidate) -ne ".patch") {
+            throw "Invalid patch path: $candidate"
+        }
+        $patchPaths += $candidate
+    }
+
+    git am --3way -- $patchPaths
+    if ($LASTEXITCODE -ne 0) {
+        throw "Patch replay stopped. Resolve with git am --continue or abort with git am --abort."
+    }
+}
+finally {
+    Pop-Location
+}
diff --git a/tools/refresh-patchset.ps1 b/tools/refresh-patchset.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..977c6c5386cedc7027f06c224bcbe8e27014f816
--- /dev/null
+++ b/tools/refresh-patchset.ps1
@@ -0,0 +1,42 @@
+param([string]$Base = "j2k/master")
+
+$ErrorActionPreference = "Stop"
+$repositoryRoot = (Resolve-Path (Join-Path $PSScriptRoot "..")).Path
+$patchRoot = (Resolve-Path (Join-Path $repositoryRoot "patches")).Path
+
+if ((Split-Path -Parent $patchRoot) -ne $repositoryRoot) {
+    throw "Patch directory escaped the repository root: $patchRoot"
+}
+
+Push-Location $repositoryRoot
+try {
+    if (git status --porcelain) {
+        throw "Commit or stash all changes before refreshing the patch stack."
+    }
+
+    $baseCommit = (git rev-parse "$Base^{commit}").Trim()
+    git merge-base --is-ancestor $baseCommit HEAD
+    if ($LASTEXITCODE -ne 0) {
+        throw "$Base is not an ancestor of HEAD."
+    }
+
+    Get-ChildItem -LiteralPath $patchRoot -Filter "*.patch" -File | ForEach-Object {
+        if ($_.DirectoryName -ne $patchRoot) {
+            throw "Refusing to remove a patch outside $patchRoot"
+        }
+        Remove-Item -LiteralPath $_.FullName
+    }
+
+    $output = git format-patch --binary --full-index --no-stat --output-directory $patchRoot "$baseCommit..HEAD"
+    if ($LASTEXITCODE -ne 0) {
+        throw "git format-patch failed."
+    }
+
+    $patchNames = @($output | ForEach-Object { Split-Path -Leaf $_ })
+    Set-Content -LiteralPath (Join-Path $patchRoot "UPSTREAM_BASE") -Value $baseCommit -Encoding utf8NoBOM
+    Set-Content -LiteralPath (Join-Path $patchRoot "series") -Value $patchNames -Encoding utf8NoBOM
+    Write-Host "Exported $($patchNames.Count) Hayai patches from $baseCommit."
+}
+finally {
+    Pop-Location
+}
diff --git a/tools/verify-upstream-boundary.ps1 b/tools/verify-upstream-boundary.ps1
