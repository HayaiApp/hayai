Subject: [PATCH] Classify manga and novel extension content


diff --git a/app/src/main/java/dev/ahmedmohamed/hayai/novel/extension/NovelApkExtensionManager.kt b/app/src/main/java/dev/ahmedmohamed/hayai/novel/extension/NovelApkExtensionManager.kt
index a897cf2b76188eaf67704775ecb83629df78b70b..7f72c1bbc1c5b34dc90ff210a4f31d0f7e6dce4b 100644
