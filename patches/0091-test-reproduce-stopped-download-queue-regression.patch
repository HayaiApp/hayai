From 82abd839eeed777432c7fa90433c5bccac601333 Mon Sep 17 00:00:00 2001
From: Ahmed Mohamed <50212311+ig4e@users.noreply.github.com>
Date: Sun, 23 Aug 2026 21:11:47 +0300
Subject: [PATCH] test: reproduce stopped download queue regression


diff --git a/app/src/test/java/eu/kanade/tachiyomi/data/download/DownloadQueueStartPolicyTest.kt b/app/src/test/java/eu/kanade/tachiyomi/data/download/DownloadQueueStartPolicyTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..b7d9def965af4aca23580a349afa2b281fe4b88b
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/data/download/DownloadQueueStartPolicyTest.kt
@@ -0,0 +1,37 @@
+package eu.kanade.tachiyomi.data.download
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class DownloadQueueStartPolicyTest {
+    @Test
+    fun `explicit auto start resumes a stopped non-empty queue`() {
+        assertTrue(
+            DownloadQueueStartPolicy.shouldStart(
+                autoStart = true,
+                downloaderRunning = false,
+            ),
+        )
+    }
+
+    @Test
+    fun `manual queueing preserves a stopped queue`() {
+        assertFalse(
+            DownloadQueueStartPolicy.shouldStart(
+                autoStart = false,
+                downloaderRunning = false,
+            ),
+        )
+    }
+
+    @Test
+    fun `an already running downloader is not restarted`() {
+        assertFalse(
+            DownloadQueueStartPolicy.shouldStart(
+                autoStart = true,
+                downloaderRunning = true,
+            ),
+        )
+    }
+}
