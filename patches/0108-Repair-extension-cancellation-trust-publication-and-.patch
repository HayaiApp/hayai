diff --git a/app/src/test/java/dev/ahmedmohamed/hayai/novel/plugin/NovelPluginDownloadTest.kt b/app/src/test/java/dev/ahmedmohamed/hayai/novel/plugin/NovelPluginDownloadTest.kt
