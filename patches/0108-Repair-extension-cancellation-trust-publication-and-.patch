diff --git a/app/src/test/java/dev/ahmedmohamed/hayai/extension/install/ExtensionInstallLifecycleTest.kt b/app/src/test/java/dev/ahmedmohamed/hayai/extension/install/ExtensionInstallLifecycleTest.kt
