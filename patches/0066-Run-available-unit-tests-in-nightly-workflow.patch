From 5be4ed1e0c6f4c3a85f38a3917234d511113a261 Mon Sep 17 00:00:00 2001
From: Ahmed Mohamed <50212311+ig4e@users.noreply.github.com>
Date: Sat, 22 Aug 2026 14:52:24 +0300
Subject: [PATCH] Run available unit tests in nightly workflow


diff --git a/.github/workflows/nightly.yml b/.github/workflows/nightly.yml
index 089374be2ca54e55ebc57d3974ee83ed440da523..06975dc46225e8ccbfae005b688d397c4d502d45 100644
--- a/.github/workflows/nightly.yml
+++ b/.github/workflows/nightly.yml
@@ -62,7 +62,10 @@ jobs:
           echo "COMMIT_SHORT_SHA=$(git rev-parse --short HEAD)" >> "$GITHUB_ENV"
 
       - name: Build and test
-        run: ./gradlew assembleStandardNightly testStandardNightlyUnitTest -x formatKotlin
+        # This project only creates a unit-test component for DevDebug. Exercise
+        # the shared production code through that existing test variant while
+        # assembling the signed StandardNightly artifacts.
+        run: ./gradlew assembleStandardNightly testDevDebugUnitTest -x formatKotlin
 
       - name: Detect Android build tools
         shell: bash
-- 
