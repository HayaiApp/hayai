+            assertTrue(definition.copy(headers = mapOf(name to "secret")).validate().any { it.field == "headers" })
+        }
+        assertTrue(definition.copy(headers = mapOf("Accept" to "text/html\r\nCookie: secret")).validate().any { it.field == "headers" })
