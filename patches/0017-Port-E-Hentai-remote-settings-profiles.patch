+        assertEquals("", entries["xl_2048"])
+        assertFalse("xl_0" in entries)
+        assertEquals("1", entries["ct_doujinshi"])
+        assertEquals("0", entries["ct_manga"])
+        assertEquals("1", entries["ct_misc"])
+        assertEquals("Apply", entries["apply"])
+    }
