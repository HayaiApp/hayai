+        val changed = settings(excluded = setOf(EhCategory.Manga))
+
+        assertEquals(first.fingerprint(), same.fingerprint())
+        assertTrue(first.fingerprint() != changed.fingerprint())
+        assertEquals(64, first.fingerprint().length)
+    }
