+object BundledSourceIconResolver {
+    @DrawableRes
+    fun resource(sourceId: Long): Int? = when (sourceId) {
+        EhSite.EHentai.sourceId -> R.mipmap.ic_ehentai_source
+        EhSite.ExHentai.sourceId -> R.mipmap.ic_exhentai_source
