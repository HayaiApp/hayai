diff --git a/app/src/test/java/dev/ahmedmohamed/hayai/adult/eh/session/EhSessionStoreTest.kt b/app/src/test/java/dev/ahmedmohamed/hayai/adult/eh/session/EhSessionStoreTest.kt
new file mode 100644
