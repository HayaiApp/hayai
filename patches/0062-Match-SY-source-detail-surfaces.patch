+        moreInfo.bindIcon(R.drawable.ic_info_24dp)
+        moreInfo.setOnClickListener { onMoreInfo() }
+
+        listOf(genre, pages, rating, language, size, favorites, visible, uploader).forEach { value ->
+            value.copyOnLongClick()
+        }
+    }
