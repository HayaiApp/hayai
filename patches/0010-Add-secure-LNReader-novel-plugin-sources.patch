+                is Element -> el.nextElementSibling()
+                is Elements -> el.firstOrNull()?.nextElementSibling()
+                else -> null
+            }
+        return if (next != null) {
+            val newHandle = ++handleCounter
+            elementCache[newHandle] = next
+            newHandle
+        } else {
+            -1
+        }
+    }
