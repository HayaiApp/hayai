+    private fun cheerioParent(handle: Int): Int {
+        val el = elementCache[handle]
+        val parent =
+            when (el) {
+                is Element -> el.parent()
+                is Elements -> el.firstOrNull()?.parent()
+                else -> null
+            }
+        return if (parent != null) {
+            val newHandle = ++handleCounter
+            elementCache[newHandle] = parent
+            newHandle
+        } else {
+            -1
+        }
+    }
