+    private fun cheerioIs(
+        handle: Int,
+        selector: String,
+    ): Boolean {
+        val normalizedSelector = normalizeSelectorForJsoup(selector)
+        return when (val el = elementCache[handle]) {
+            is Element -> el.`is`(normalizedSelector)
+            is Elements -> el.any { it.`is`(normalizedSelector) }
+            else -> false
+        }
+    }
