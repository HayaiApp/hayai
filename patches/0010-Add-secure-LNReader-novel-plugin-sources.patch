+                val nameIndex = cursor.getColumnIndex("name")
+                generateSequence { if (cursor.moveToNext()) cursor.getString(nameIndex) else null }.any { it == column }
+            }
+        if (!exists) db.execSQL("ALTER TABLE $table ADD COLUMN $column $declaration")
+    }
 }
