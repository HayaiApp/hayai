+        val position = progress.coerceIn(0, 100)
+        val completed = position >= markReadThreshold.coerceIn(1, 100)
+        return NovelProgressUpdate(
+            position = position,
+            pagesLeft = if (completed) 0 else 100 - position,
+            completed = completed,
+        )
