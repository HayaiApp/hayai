+    store: PreferenceStore,
+) {
+    val customSeedEnabled: Preference<Boolean> =
+        store.getBoolean(KEY_CUSTOM_SEED_ENABLED, false)
+    val customSeedColor: Preference<Int> =
+        store.getInt(KEY_CUSTOM_SEED_COLOR, DEFAULT_SEED_COLOR)
